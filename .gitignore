# Dependencies
node_modules/
.pnpm-store/

# Build output
# lib/ is committed: git-hosted installs (pnpm git deps) and tarball installs
# must work without a build step, so the prebuilt artifacts ship in the repo.
dist/
*.tsbuildinfo
*.tgz
.*.mjs
*.tmp

# Internal notes & prompts (not for distribution)
prompts.md
FEATURES.md
DESIGN.md
PRODUCT.md
AGENTS.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
.agents/
openspec/
# docs/ mostly holds internal notes, but the workflow guide is published and is
# linked from README, so it must stay tracked. A blanket `docs/` entry would also
# make the negation below ineffective, hence the `docs/*` form.
docs/*
!docs/agent-workflow.md
ppt-output/

