{
  "name": "@yejiming/dsh-ppt",
  "description": "PPT design preset and editable PPTX production tools for DeepSeek Harness",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yejiming/dsh-ppt.git"
  },
  "homepage": "https://github.com/yejiming/dsh-ppt#readme",
  "bugs": {
    "url": "https://github.com/yejiming/dsh-ppt/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.mjs"
    },
    "./headless": {
      "types": "./lib/types/headless.d.ts",
      "default": "./lib/headless.mjs"
    },
    "./runtime": {
      "types": "./lib/types/runtime.d.ts",
      "default": "./lib/runtime.mjs"
    },
    "./schemas": {
      "types": "./lib/types/schemas.d.ts",
      "default": "./lib/schemas.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "dependencies": {
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "happy-dom": "20.0.11",
    "playwright-core": "1.62.1",
    "pptxgenjs": "4.0.1",
    "schemastery": "3.18.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-tool-presentation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-bash": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "sharp": "^0.35.3"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-replay": "0.2.0-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "25.0.0",
    "js-yaml": "^4.1.0",
    "sharp": "0.35.4",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
